# Core app / local Postgres
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="nashboard"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"
# Optional: set only when testing on LAN (example: 192.168.1.20)
NASHBOARD_DEV_HOST=""

# Auth.js / NextAuth (required for email/password AND Google sign-in)
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-secret"
# Must match the deployed origin exactly, e.g. https://nashboard.example.com
NEXTAUTH_URL="http://localhost:3000"
# Only needed for multi-subdomain deploys, e.g. ".nashboard.example.com"
NEXTAUTH_COOKIE_DOMAIN=""
# Optional Google OAuth — leave the placeholders to disable the Google button
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Dev-only hard-coded admin/admin login. MUST be unset or "false" in production.
DEV_ADMIN_ENABLED="false"

# Optional API-Sports endpoints (legacy/optional)
API_SPORTS_KEY="YOUR_API_KEY"
SPORTS_API_KEY="YOUR_API_KEY"
NBA_API_BASE_URL="https://v1.basketball.api-sports.io"
NFL_API_BASE_URL="https://v1.american-football.api-sports.io"
MLB_API_BASE_URL="https://v1.baseball.api-sports.io"
SPORTS_API_NBA_BASE_URL="https://v1.basketball.api-sports.io"
SPORTS_API_NFL_BASE_URL="https://v1.american-football.api-sports.io"
SPORTS_API_MLB_BASE_URL="https://v1.baseball.api-sports.io"
SPORTS_API_TIMEZONE="America/New_York"
SPORTS_API_DATE_OVERRIDE=""
