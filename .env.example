# Core app / local Postgres
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="nashboard"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"
NASHBOARD_DEV_HOST="192.168.220.1"

# Auth.js / NextAuth (required for Google sign-in)
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional API-Sports endpoints (legacy/optional)
SPORTS_API_KEY="YOUR_API_KEY"
SPORTS_API_NBA_BASE_URL="https://v2.nba.api-sports.io"
NBA_LEAGUE_ID="12"
NBA_SEASON="2024-2025"
SPORTS_API_NFL_BASE_URL="https://v1.american-football.api-sports.io"
NFL_LEAGUE_ID="1"
NFL_SEASON="2024"
SPORTS_API_MLB_BASE_URL="https://v1.baseball.api-sports.io"
MLB_LEAGUE_ID="1"
MLB_SEASON="2024"
